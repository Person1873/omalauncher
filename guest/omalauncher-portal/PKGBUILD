# Local packages for omalauncher's Linux: pacman then knows about what the launcher provides itself.
pkgbase=omalauncher-guest
pkgname=(omalauncher-portal omalauncher-bwrap)
pkgver=1
pkgrel=1
arch=(aarch64)
license=(MIT)
makedepends=(gcc pkgconf glib2 gtk3)
source=(omalauncher-portal.c filechooser-module.c org.freedesktop.portal.Desktop.service)
sha256sums=(SKIP SKIP SKIP)

build() {
  gcc $CFLAGS $LDFLAGS -o omalauncher-portal omalauncher-portal.c $(pkg-config --cflags --libs gio-2.0)
  gcc $CFLAGS $LDFLAGS -shared -fPIC -o libomalauncher-filechooser.so filechooser-module.c $(pkg-config --cflags --libs gtk+-3.0)
}

# The file chooser portal: the launcher's Files app picks for Linux apps. xdg-desktop-portal can't run
# under proot (it identifies callers through /proc/<pid>/root), so this one stands in for it, and for
# xdg-desktop-portal-gtk, which gtk4 depends on.
package_omalauncher-portal() {
  pkgdesc="File dialogs for Linux apps through omalauncher's Files app (file chooser portal, GTK3 module)"
  depends=(glib2 gtk3)
  provides=(xdg-desktop-portal xdg-desktop-portal-impl xdg-desktop-portal-gtk)
  conflicts=(xdg-desktop-portal xdg-desktop-portal-gtk)
  install -Dm755 omalauncher-portal "$pkgdir/usr/lib/omalauncher/omalauncher-portal"
  install -Dm644 org.freedesktop.portal.Desktop.service "$pkgdir/usr/share/dbus-1/services/org.freedesktop.portal.Desktop.service"
  install -Dm755 libomalauncher-filechooser.so "$pkgdir/usr/lib/gtk-3.0/modules/libomalauncher-filechooser.so"
}

# No files: the launcher puts its own bwrap at /usr/bin/bwrap (bubblewrap can't sandbox under proot).
package_omalauncher-bwrap() {
  pkgdesc="Tells pacman that omalauncher provides bwrap (its shim at /usr/bin/bwrap)"
  provides=(bubblewrap=0.13.1)
  conflicts=(bubblewrap)
}
